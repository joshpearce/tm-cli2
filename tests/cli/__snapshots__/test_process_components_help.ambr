# serializer version: 1
# name: test_help_snapshots[create]
  '''
  Usage: cli process-component create [OPTIONS]
  
    Create a process component. Use named flags or --stdin.
  
  Options:
    --name TEXT                     Process component name.
    --description TEXT              Process component description.
    --component-type [controller|service|filter|repository|utility|client|handler|interceptor|configuration]
                                    Process component type.
    --parent-process-id INTEGER     Parent process node id (required).
    --stdin                         Read JSON object or array from stdin instead
                                    of named flags.
    --if-not-exists                 No-op for ProcessComponent; kept for
                                    consistency.
    --dry-run                       Dry-run.
    --help                          Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[delete]
  '''
  Usage: cli process-component delete [OPTIONS] COMPONENT_ID
  
    Delete a process component.
  
  Options:
    --yes      Skip confirmation prompt.
    --dry-run  Dry-run.
    --help     Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[get]
  '''
  Usage: cli process-component get [OPTIONS] COMPONENT_ID
  
    Get a process component by id.
  
  Options:
    --json FIELDS  Comma-separated field names to include in output.
    --help         Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[group]
  '''
  Usage: cli process-component [OPTIONS] COMMAND [ARGS]...
  
    Manage process components.
  
  Options:
    --help  Show this message and exit.
  
  Commands:
    create              Create a process component.
    delete              Delete a process component.
    get                 Get a process component by id.
    link-document       Link a document to this process component.
    link-observation    Link an observation to this process component.
    list                List process components in a diagram (defaults to the...
    list-documents      List documents linked to this process component.
    list-observations   List observations linked to this process component.
    search              Search process components by name or description.
    set-parent          Reassign a process component to a different process...
    unlink-document     Remove a document↔process-component link.
    unlink-observation  Remove an observation↔process-component link.
    update              Update a process component.
  
  '''
# ---
# name: test_help_snapshots[link-document]
  '''
  Usage: cli process-component link-document [OPTIONS] COMPONENT_ID DOC_ID
  
    Link a document to this process component. Idempotent.
  
  Options:
    --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[link-observation]
  '''
  Usage: cli process-component link-observation [OPTIONS] COMPONENT_ID OBS_ID
  
    Link an observation to this process component. Idempotent.
  
  Options:
    --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[list-documents]
  '''
  Usage: cli process-component list-documents [OPTIONS] COMPONENT_ID
  
    List documents linked to this process component.
  
  Options:
    --order [asc|desc]      Sort direction.  [default: asc]
    --sort FIELD            Column to sort by.  [default: id]
    --offset INTEGER RANGE  Rows to skip from the start.  [default: 0; x>=0]
    --limit INTEGER RANGE   Maximum rows to return.  [default: 50; 1<=x<=10000]
    --json FIELDS           Comma-separated field names to include in output.
    --help                  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[list-observations]
  '''
  Usage: cli process-component list-observations [OPTIONS] COMPONENT_ID
  
    List observations linked to this process component.
  
  Options:
    --order [asc|desc]      Sort direction.  [default: asc]
    --sort FIELD            Column to sort by.  [default: id]
    --offset INTEGER RANGE  Rows to skip from the start.  [default: 0; x>=0]
    --limit INTEGER RANGE   Maximum rows to return.  [default: 50; 1<=x<=10000]
    --json FIELDS           Comma-separated field names to include in output.
    --help                  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[list]
  '''
  Usage: cli process-component list [OPTIONS]
  
    List process components in a diagram (defaults to the 'default' diagram).
  
  Options:
    --order [asc|desc]              Sort direction.  [default: asc]
    --sort FIELD                    Column to sort by.  [default: id]
    --offset INTEGER RANGE          Rows to skip from the start.  [default: 0;
                                    x>=0]
    --limit INTEGER RANGE           Maximum rows to return.  [default: 50;
                                    1<=x<=10000]
    --parent-process-id TEXT        Filter to process components whose
                                    parent_process_id equals this integer.
    --component-type [controller|service|filter|repository|utility|client|handler|interceptor|configuration]
                                    Filter to process components with this
                                    component type.
    --json FIELDS                   Comma-separated field names to include in
                                    output.
    --help                          Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[search]
  '''
  Usage: cli process-component search [OPTIONS] [TEXT]...
  
    Search process components by name or description.
  
  Options:
    --order [asc|desc]              Sort direction.  [default: asc]
    --sort FIELD                    Column to sort by.  [default: id]
    --offset INTEGER RANGE          Rows to skip from the start.  [default: 0;
                                    x>=0]
    --limit INTEGER RANGE           Maximum rows to return.  [default: 50;
                                    1<=x<=10000]
    --parent-process-id TEXT        Filter to process components whose
                                    parent_process_id equals this integer.
    --component-type [controller|service|filter|repository|utility|client|handler|interceptor|configuration]
                                    Filter to process components with this
                                    component type.
    --json FIELDS                   Comma-separated field names to include in
                                    output.
    --help                          Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[set-parent]
  '''
  Usage: cli process-component set-parent [OPTIONS] COMPONENT_ID PROCESS_NODE_ID
  
    Reassign a process component to a different process node.
  
  Options:
    --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[unlink-document]
  '''
  Usage: cli process-component unlink-document [OPTIONS] COMPONENT_ID DOC_ID
  
    Remove a document↔process-component link. Idempotent.
  
  Options:
    --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[unlink-observation]
  '''
  Usage: cli process-component unlink-observation [OPTIONS] COMPONENT_ID OBS_ID
  
    Remove an observation↔process-component link. Idempotent.
  
  Options:
    --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[update]
  '''
  Usage: cli process-component update [OPTIONS] COMPONENT_ID
  
    Update a process component.
  
  Options:
    --name TEXT                     Process component name.
    --description TEXT              Process component description.
    --component-type [controller|service|filter|repository|utility|client|handler|interceptor|configuration]
                                    Process component type.
    --parent-process-id INTEGER     Set parent process node id (integer; cannot be
                                    cleared).
    --stdin                         Read JSON object from stdin instead of named
                                    flags.
    --dry-run                       Dry-run.
    --help                          Show this message and exit.
  
  '''
