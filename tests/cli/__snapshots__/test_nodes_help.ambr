# name: test_help_snapshots[update-external-entity]
  '''
  Usage: cli node update external-entity [OPTIONS] NODE_ID
  
    Update an external entity node.
  
  Options:
    --name TEXT
    --description TEXT
    --entity-type [user|service|system|device]
    --out-of-scope / --no-out-of-scope
    --stdin
    --dry-run
    --help                          Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[update-process]
  '''
  Usage: cli node update process [OPTIONS] NODE_ID
  
    Update a process node.
  
  Options:
    --name TEXT
    --description TEXT
    --trust-level [public|authenticated|admin|system]
    --assumption TEXT               Repeatable. Pass to replace the assumptions
                                    list. Omit to leave unchanged.
    --stdin
    --dry-run
    --help                          Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[update]
  '''
  Usage: cli node update [OPTIONS] COMMAND [ARGS]...
  
    Update a node of a specific variant.
  
    The variant must match the row's existing type.
  
  Options:
    --help  Show this message and exit.
  
  Commands:
    data-store       Update a data store node.
    external-entity  Update an external entity node.
    process          Update a process node.
  
  '''
# ---
