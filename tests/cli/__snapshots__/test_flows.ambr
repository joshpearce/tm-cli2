# serializer version: 1
# name: test_create_canonicalizes_endpoints_when_n1_gt_n2
  dict({
    'authenticated': False,
    'diagram_id': '1',
    'encrypted': False,
    'id': '11',
    'name': 'test-canonicalize',
    'node1_id': '1',
    'node2_id': '3',
    'protocol': 'HTTP',
  })
# ---
# name: test_create_cross_diagram_exits_1
  dict({
    'error': dict({
      'code': 'user_error',
      'message': 'Endpoint 11 is not in diagram 1',
    }),
  })
# ---
# name: test_create_self_loop_exits_1_with_hint
  dict({
    'error': dict({
      'code': 'user_error',
      'message': 'Self-loops are not allowed',
    }),
  })
# ---
# name: test_get_missing_id_exits_2
  dict({
    'error': dict({
      'code': 'not_found',
      'id': '99999',
      'message': 'DataFlow id=99999 not found',
    }),
  })
# ---
