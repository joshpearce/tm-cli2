# name: test_help_snapshots[unlink-term]
  '''
  Usage: cli document unlink-term [OPTIONS] DOC_ID TERM_ID
  
    Remove a document↔term link. Idempotent: returns unlinked=false if not linked.
  
  Options:
    --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[update]
  '''
  Usage: cli document update [OPTIONS] DOC_ID
  
    Apply a partial update to a document.
  
  Options:
    --last-updated [%Y-%m-%d|%Y-%m-%dT%H:%M:%S|%Y-%m-%d %H:%M:%S]
    --title TEXT
    --author TEXT
    --content TEXT
    --stdin                         Read a JSON object from stdin with the patch
                                    fields.
    --dry-run
    --help                          Show this message and exit.
  
  '''
