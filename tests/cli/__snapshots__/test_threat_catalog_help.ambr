# name: test_help_snapshots[group]
  '''
  Usage: cli threat-catalog [OPTIONS] COMMAND [ARGS]...
  
    Manage MITRE ATT&CK threat catalog entries.
  
  Options:
    --help  Show this message and exit.
  
  Commands:
    get         Fetch a threat catalog entry by id.
    import-dir  Import extracted MITRE techniques from markdown files in PATH.
    list        List threat catalog entries.
    search      Search threat catalog entries by text.
  
  '''
# ---
# name: test_help_snapshots[import-dir]
  '''
  Usage: cli threat-catalog import-dir [OPTIONS] PATH
  
    Import extracted MITRE techniques from markdown files in PATH.
  
  Options:
    --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[list]
  '''
  Usage: cli threat-catalog list [OPTIONS]
  
    List threat catalog entries.
  
  Options:
    --order [asc|desc]      Sort direction.  [default: asc]
    --sort FIELD            Column to sort by.  [default: id]
    --offset INTEGER RANGE  Rows to skip from the start.  [default: 0; x>=0]
    --limit INTEGER RANGE   Maximum rows to return.  [default: 50; 1<=x<=10000]
    --json FIELDS           Comma-separated field names to include in output.
    --help                  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshots[search]
  '''
  Usage: cli threat-catalog search [OPTIONS] [TEXT]...
  
    Search threat catalog entries by text.
  
  Options:
    --order [asc|desc]      Sort direction.  [default: asc]
    --sort FIELD            Column to sort by.  [default: id]
    --offset INTEGER RANGE  Rows to skip from the start.  [default: 0; x>=0]
    --limit INTEGER RANGE   Maximum rows to return.  [default: 50; 1<=x<=10000]
    --json FIELDS           Comma-separated field names to include in output.
    --help                  Show this message and exit.
  
  '''
