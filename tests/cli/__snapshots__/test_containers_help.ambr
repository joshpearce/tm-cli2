# name: test_help_snapshots[update]
  '''
  Usage: cli container update [OPTIONS] COMMAND [ARGS]...
  
    Update a container of a specific variant.
  
    The variant must match the row's existing type.
  
  Options:
    --help  Show this message and exit.
  
  Commands:
    container       Update a generic container.
    trust-boundary  Update a trust boundary.
  
  '''
