# name: test_stdin_array_creates_n_rows_in_order
  list([
    dict({
      'author': 'a',
      'content': 'c1',
      'id': '1',
      'last_imported': '<DATETIME>',
      'last_updated': '<DATETIME>',
      'title': 'First',
    }),
    dict({
      'author': 'b',
      'content': 'c2',
      'id': '2',
      'last_imported': '<DATETIME>',
      'last_updated': '<DATETIME>',
      'title': 'Second',
    }),
  ])
# ---
# name: test_stdin_single_object_creates_one_row
  dict({
    'author': 'agent',
    'content': '...body...',
    'id': '1',
    'last_imported': '<DATETIME>',
    'last_updated': '<DATETIME>',
    'title': 'ViaStdin',
  })
# ---
